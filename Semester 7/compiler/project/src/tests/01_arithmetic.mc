int main() {
    int a = 10 + 20 * 2;
    println(a); // 50

    int b = (10 + 20) * 2;
    println(b); // 60

    float c = 15.0 / 2.0;
    println(c); // 7.5

    int d = 15 / 2;
    println(d); // 7

    int neg = -42;
    println(neg); // -42

    float fneg = -3.5;
    println(fneg); // -3.5

    return 0;
}
